# ============================================================
# Secondhand POS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# JWT Secret Key (REQUIRED — change this in production!)
# Generate a strong random key:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# Database credentials
DB_HOST=db
DB_NAME=pos_system
DB_USER=posuser
DB_PASS=pospass

# MySQL root password
MYSQL_ROOT_PASSWORD=rootpass

# MySQL application user (must match DB_USER)
MYSQL_USER=posuser
MYSQL_PASSWORD=pospass

# phpMyAdmin
PMA_USER=root
PMA_PASSWORD=rootpass
