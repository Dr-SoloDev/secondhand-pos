# ============================================================
# Secondhand POS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# App environment — set to "production" on Ubuntu server
APP_ENV=development

# Authentication hardening
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=120
# Set true only when requests always pass through a trusted reverse proxy.
TRUST_PROXY=false

# JWT Secret Key (REQUIRED — change this in production!)
#   openssl rand -hex 32
# Generate a strong random key:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# Database credentials (REQUIRED — no hardcoded fallback)
DB_HOST=db
DB_NAME=pos_system
DB_USER=posuser
DB_PASS=pospass

# MySQL root password
MYSQL_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# MySQL application user (must match DB_USER)
MYSQL_USER=posuser
MYSQL_PASSWORD=pospass

# phpMyAdmin
PMA_USER=root
PMA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Domain for Caddy reverse proxy (SSL/TLS via Let's Encrypt)
DOMAIN=pos.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
